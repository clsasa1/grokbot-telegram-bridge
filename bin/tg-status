#!/usr/bin/env python3
# Usage: tg-status <thread_id|dm> ["text"]  -> sends a live status message (default "⏳ работаю…"), prints "ok <message_id>".
#   Update it later with: tg-edit <dm|group> <message_id> "html text"; remove with tg-delete. Does not stop tg-typing.
import sys; sys.path.insert(0,"/home/box/bin"); from tglib import *
res(call_html("sendMessage",dict(target(sys.argv[1]),text=sys.argv[2] if len(sys.argv)>2 else "⏳ работаю…")))
