# Скопируй в /home/box/tgrelay/config.env и заполни. НЕ коммить настоящий файл.
TELEGRAM_BOT_TOKEN=123456:ABC...        # от @BotFather
TG_USER_ID=123456789                    # твой Telegram user id (узнать у @userinfobot)
TG_GROUP_ID=-100XXXXXXXXXX              # id форум-группы с ботом (можно оставить 0, если только личка)
TG_ROUTINE_WEBHOOK_URL=https://...      # Webhook URL из панели рутины
TG_ROUTINE_WEBHOOK_KEY=...              # ключ вебхука из панели рутины
